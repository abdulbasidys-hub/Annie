# Annie — copy to .env and fill in. Never commit .env.

# ============================== RAILWAY (backend) ==============================

# Firestore service account (Firebase Console -> Project settings -> Service
# accounts -> Generate new private key). Locally, point FIREBASE_SERVICE_ACCOUNT_FILE
# at the downloaded file. On Railway, use FIREBASE_SERVICE_ACCOUNT_JSON instead,
# set to that file's exact contents — Railway can't take a file upload.
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=

OPENAI_API_KEY=
TAVILY_API_KEY=

# helius.dev — without these, discovery finds nothing.
HELIUS_API_KEY=
HELIUS_RPC_URL=

# Shared secret Helius sends back on every webhook call. Same value goes
# into the webhook's "authHeader" when the webhook itself is registered
# (see README's Setup, Step 4). Without this, discovery silently gets
# nothing even with a valid HELIUS_API_KEY.
HELIUS_WEBHOOK_SECRET=

TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# localhost locally, your Vercel URL on Railway.
CORS_ORIGINS=http://localhost:5180

# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use a different AUTH_SECRET on Railway than locally.
AUTH_SECRET=
AUTH_USERNAME=
AUTH_PASSWORD=

# ============================== VERCEL (frontend) ===============================

# localhost locally, your Railway URL on Vercel.
VITE_API_BASE_URL=http://localhost:8000

# =============================================================================
# Memory (2026-09-08 rewrite)
# =============================================================================

# Where Annie's markdown memory, her SQLite ledger and her search index live.
#
# On Railway this MUST point at an attached Volume's mount path, e.g.
# /data/memory. The container filesystem is replaced on every redeploy, so
# without a volume the only thing keeping memory alive is the Firestore
# mirror, which restores on boot but is a backup rather than the real thing.
# Attach a Volume in the Railway dashboard, mount it at /data, and set this.
#
# Locally, leave it unset — memory then lives in ./memory in the repo, where
# you can open the files directly.
ANNIE_MEMORY_DIR=

# Hard ceilings on Firestore usage per UTC day, enforced in-process
# (app/db/budget.py). The Spark (free) plan allows 20,000 writes and 50,000
# reads per day across the whole project; these sit well under that so a
# runaway loop degrades into "memory-only, logged" instead of hitting the
# plan's wall mid-cycle. Raise them only if you move off Spark.
FIRESTORE_WRITE_BUDGET_PER_DAY=4000
FIRESTORE_READ_BUDGET_PER_DAY=12000

# How many mints the watch loop re-prices per pass. These go out batched 30
# per HTTP request, so 900 is 30 requests, not 900.
WATCH_BATCH_SIZE=900

# How long an unmoved launch stays in the ledger before being forgotten.
WATCH_TTL_HOURS=48

# Serve the HTTP API only — no bots, no scheduler. For running a second
# read-only instance, or for tests. Leave false on the primary deployment.
ANNIE_API_ONLY=false
