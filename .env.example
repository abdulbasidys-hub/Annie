# Annie — copy to .env and fill in. Never commit .env.

# ============================== RAILWAY (backend) ==============================

# Firestore service account (Firebase Console -> Project settings -> Service
# accounts -> Generate new private key). Locally, point FIREBASE_SERVICE_ACCOUNT_FILE
# at the downloaded file. On Railway, use FIREBASE_SERVICE_ACCOUNT_JSON instead,
# set to that file's exact contents — Railway can't take a file upload.
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=

OPENAI_API_KEY=
TAVILY_API_KEY=

# helius.dev — without these, discovery finds nothing.
HELIUS_API_KEY=
HELIUS_RPC_URL=

# Shared secret Helius sends back on every webhook call. Same value goes
# into the webhook's "authHeader" when the webhook itself is registered
# (see README's Setup, Step 4). Without this, discovery silently gets
# nothing even with a valid HELIUS_API_KEY.
HELIUS_WEBHOOK_SECRET=

TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# localhost locally, your Vercel URL on Railway.
CORS_ORIGINS=http://localhost:5180

# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use a different AUTH_SECRET on Railway than locally.
AUTH_SECRET=
AUTH_USERNAME=
AUTH_PASSWORD=

# ============================== VERCEL (frontend) ===============================

# localhost locally, your Railway URL on Vercel.
VITE_API_BASE_URL=http://localhost:8000
