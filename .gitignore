# ---- Secrets -------------------------------------------------------------
.env
.env.*
!.env.example

# Firebase service-account keys. Full admin access to Firestore — never
# committed. Matches the filename Firebase Console generates
# (<project>-firebase-adminsdk-<id>.json) plus common alternates.
*firebase-adminsdk*.json
serviceAccount*.json
service-account*.json

